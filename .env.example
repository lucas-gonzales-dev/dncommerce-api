# Variáveis de ambiente

# Porta do servidor
PORT=3000

# String de conexão do MongoDB
# Para MongoDB local:
MONGODB_URI=mongodb://localhost:27017/dncommerce

# Para MongoDB Atlas (descomente e configure):
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/dncommerce?retryWrites=true&w=majority
